ARG NODE_VERSION=26.10
FROM node:${NODE_VERSION}-alpine

ARG PNPM_VERSION=12.8

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV PNPM_CONFIG_STORE_DIR="/pnpm/store"

WORKDIR /app

RUN npm install --global --allow-scripts=pnpm pnpm@${PNPM_VERSION}

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile && \
    sha256sum package.json pnpm-lock.yaml pnpm-workspace.yaml > node_modules/.pnpm-install.sha256

COPY . .
COPY docker-entrypoint.dev /usr/local/bin/frontend-entrypoint
RUN sed -i "s/\r$//g" /usr/local/bin/frontend-entrypoint && \
    chmod +x /usr/local/bin/frontend-entrypoint

ENTRYPOINT ["frontend-entrypoint"]

EXPOSE 5173

CMD ["pnpm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
