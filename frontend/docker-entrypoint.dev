#!/bin/sh
set -e

install_hash="$(sha256sum package.json pnpm-lock.yaml pnpm-workspace.yaml)"
stamp_file="node_modules/.pnpm-install.sha256"

if [ ! -f "$stamp_file" ] || [ "$(cat "$stamp_file")" != "$install_hash" ]; then
  echo "Installing frontend dependencies..."
  pnpm install --frozen-lockfile
  printf "%s\n" "$install_hash" > "$stamp_file"
fi

exec "$@"
